// Oh My Git 配置。允许 // 和 /* */ 注释及尾随逗号；省略的字段使用内置默认值。
// 修改后在 Obsidian 中禁用再启用插件生效。
{
  // 定时同步（onCron）间隔，秒
  "syncIntervalSeconds": 300,
  // 最后一次保存后静默多少秒才触发 onSave
  "saveDebounceSeconds": 30,
  // 单条 Git 命令超时，秒
  "gitTimeoutSeconds": 120,
  // 快照中新增或修改文件的大小上限，MiB；超限文件不入库，其余照常同步并显示 !
  "maxFileMiB": 30,
  // 成功 √ 的显示时长，毫秒
  "successDisplayMs": 1000,
  // 非阻塞失败（网络、认证等）连续达到此次数后显示 ×，仍不暂停同步；任一次成功清零
  "escalateAfterFailures": 5,
  // Ctrl/Cmd+S 安慰剂的挂载方式：
  //   "default"：监听 window 捕获阶段的按键（公开 API），仅覆盖键盘快捷键
  //   "hidden"：包装内部命令 editor:save-file（未公开 API，Obsidian 升级可能失效），覆盖快捷键、命令面板和自定义快捷键
  "placeboMode": "hidden",
  // 是否在每月首次成功推送后创建 ogit/monthly/ 备份分支
  "monthlyBackupEnabled": true,
  // 使用 Git LFS 跟踪的扩展名：不含点，大小写不敏感
  "lfsExtensions": [
    // 图片
    "png", "jpg", "jpeg", "gif", "webp", "avif", "bmp", "ico", "tif", "tiff", "heic", "psd", "ai",
    // 文档
    "pdf", "doc", "docx", "xls", "xlsx", "ppt", "pptx", "odt", "ods", "odp",
    // 音视频
    "mp3", "wav", "flac", "ogg", "m4a", "aac", "mp4", "mov", "mkv", "avi", "webm",
    // 压缩包、电子书、字体、可执行文件
    "zip", "7z", "rar", "gz", "bz2", "xz", "tar", "epub", "woff", "woff2", "ttf", "otf", "exe", "dll",
  ],
}
